  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "sass": "1.105.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
